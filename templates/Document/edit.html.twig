    <script>
        window.EFFECT_PRESET_MAP = {{ allEffectPresetsMap|json_encode|raw }};
        window.MIDI_ASSETS = [
        {%- for a in (assetsParents ?? []) -%}
            {%- if a.getMimeType() == 'audio/midi' -%}
            {id: {{ a.getId() }}, originalName: "{{ a.getOriginalName()|escape('js') }}", displayName: "{{ (a.getDisplayName() ?? '')|escape('js') }}"}{{ not loop.last ? ',' : '' }}
            {%- endif -%}
        {%- endfor -%}
        ];

        function toggleMidiPreview(midiUrl, btn, documentId, assetId) {
            // Get file name from chip
            const chip = btn.closest('.chip');
            const fileName = chip.querySelector('.chip-name-display').textContent.trim();

            // Open piano roll modal with MIDI file preview
            window.openMidiFilePreview(midiUrl, fileName, documentId, assetId);
        }
    </script>

