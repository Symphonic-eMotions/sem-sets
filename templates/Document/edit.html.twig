{# templates/document/edit.html.twig #}
{% extends 'base.html.twig' %}
{% block title %}{{ document.title }}{% endblock %}

{% block body %}
    <div class="wrap">
        <div class="card">
            <h1 class="title">Bewerken Set: {{ document.title }}</h1>
            <p class="subtitle">Publiceer Symphonic eMotions muziek sets.</p>

            {% form_theme form 'forms/_theme.html.twig' %}
            {{ form_start(form, { attr: { id: 'document-form', enctype: 'multipart/form-data' } }) }}

            {# --- Set gegevens (Titel / Grid / BPM) --- #}
            <details class="page-collapsible page-collapsible-settings">
                <summary class="page-collapsible-summary">Set settings & levels</summary>
                <div class="page-collapsible-body">
            <div class="section header-settings">
                <div class="header-settings-grid">
                    <div class="header-main">
                        {{ form_row(form.title, { 
                            label: 'Set Titel', 
                            attr: { placeholder: 'Bijv. Maanlicht Sonata...' } 
                        }) }}
                    </div>
                    <div class="header-meta">
                        {{ form_row(form.gridSize, { label: 'Grid' }) }}
                        {{ form_row(form.setBPM, { label: 'BPM' }) }}
                        {{ form_row(form.timeSignature, { label: 'Maatsoort' }) }}
                    </div>
                </div>

                <div class="header-levels-row">
                    <div class="ld-container">
                        <label class="label" style="margin-bottom: 8px; display: block;">Aantal levels voor deze set</label>
                        <div class="ld-row align-items-center">
                            {# 1. Tegels #}
                            <div id="ld-tiles" class="ld-tiles" data-target="#ld-hidden-inputs"></div>

                            {# 2. Acties rechts naast de tegels #}
                            <div class="ld-actions">
                                <button type="button" class="btn-mini" id="ld-add">+ Toevoegen</button>
                                <button type="button" class="btn-mini secondary" id="ld-remove">
                                    – Verwijder laatste
                                </button>
                            </div>
                        </div>

                        {# Hidden inputs #}
                        <div id="ld-hidden-inputs"
                             class="ld-hidden"
                             data-prototype="{{ form_widget(form.levelDurations.vars.prototype)|e('html_attr') }}"
                             data-index="{{ form.levelDurations|length }}">
                            {% for field in form.levelDurations %}
                                <div class="ld-item">
                                    {{ form_widget(field) }}
                                </div>
                            {% endfor %}
                        </div>
                        {% do form.levelDurations.setRendered %}
                    </div>
                </div>
            </div>
                </div>
            </details>

            {# --- Assets --- #}
            <details class="page-collapsible page-collapsible-assets">
                <summary class="page-collapsible-summary">MIDI bestanden (upload + overzicht)</summary>
                <div class="page-collapsible-body">
            <div class="section midi-assets-section">
                <div class="section-header-row">
                    <h2 class="section-title">MIDI Bestanden</h2>
                    <div class="upload-control">
                        {{ form_widget(form.midiFiles, {
                            attr: form.midiFiles.vars.attr|merge({
                                class: (form.midiFiles.vars.attr.class|default('') ~ ' js-midi-upload custom-file-input')|trim,
                                'data-notice-target': 'midi-upload-notice'
                            })
                        }) }}
                        <div id="midi-upload-notice"></div>
                    </div>
                </div>

                <div class="midi-assets-content">
                    {# ---------------------------
                   MIDI bestanden in project
                   - Parents bovenaan
                   - Gesplitste tracks (children) direct eronder
                   --------------------------- #}

                    {% macro render_chip(a, document, midiSummariesByAssetId, isChild, childLabel) %}
                        {% set summary = midiSummariesByAssetId[a.id] ?? null %}
                        {% set summaryError = (summary is iterable and summary.error is defined) ? summary.error : null %}

                        {% set midiUrl = path('doc_asset_download', { id: document.id, assetId: a.id }) %}
                        {% set previewId = 'midi-preview-' ~ a.id %}
                        {% set vizId     = 'midi-viz-' ~ a.id %}

                        <div class="chip{{ isChild ? ' chip-child' : '' }}">

                            {# ── Bovenste rij: naam + knoppen ── #}
                            <div class="chip-row">
                                <div class="chip-main chip-main-stack">
                                    <div class="chip-name-wrapper">
                                        {# Display mode (visible by default) #}
                                        <span class="chip-name-display">
                                            {% if isChild %}
                                                <span class="subtle" style="margin-right:6px;">↳</span>
                                                {% if childLabel %}<span class="subtle">{{ childLabel }}</span>{% endif %}
                                            {% endif %}
                                            {{ a.displayName ?? a.originalName }}
                                        </span>

                                        {# Edit mode (hidden by default) #}
                                        <div class="chip-name-edit" id="chip-edit-{{ a.id }}" hidden>
                                            <input
                                                type="text"
                                                class="rename-input"
                                                value="{{ a.displayName ?? a.originalName }}"
                                                data-asset-id="{{ a.id }}"
                                                data-document-id="{{ document.id }}"
                                                data-csrf-token="{{ csrf_token('rename-asset-' ~ a.id) }}"
                                            />
                                            <button type="button" class="btn-mini-icon" onclick="saveAssetRename({{ a.id }}, {{ document.id }})" title="Opslaan">✓</button>
                                            <button type="button" class="btn-mini-icon" onclick="cancelAssetRename({{ a.id }})" title="Annuleren">✕</button>
                                        </div>
                                    </div>

                                    <span class="chip-meta subtle chip-meta-below">
                                        ({% if a.size is not null %}{{ (a.size / 1024)|number_format(1, '.', ' ') }} KB{% else %}–{% endif %}
                                        {% if summary and not summaryError %}
                                        · {{ summary.trackCount }} track{{ summary.trackCount == 1 ? '' : 's' }}
                                        · {{ summary.getDurationFormatted() }}
                                        {% endif %})
                                        {% if summary and not summaryError %}
                                            {% if summary.simultaneousNoteCount > 0 %}
                                                <span class="badge-warning" title="{{ summary.simultaneousNoteCount }} noten starten gelijktijdig">
                                                    ⚠ {{ summary.simultaneousNoteCount }} gelijktijdig
                                                </span>
                                            {% else %}
                                                <span class="subtle" style="font-size:0.78em">(geen gelijktijdige noten)</span>
                                            {% endif %}
                                        {% endif %}
                                     </span>
                                </div>

                                <div class="chip-actions">
                                    {# 1. Preview button #}
                                    <button
                                            type="button"
                                            class="btn-mini"
                                            onclick="toggleMidiPreview('{{ midiUrl }}', this, '{{ document.id }}', '{{ a.id }}')"
                                            title="Preview en piano roll"
                                    >▶ Preview</button>

                                    {% if summary and not summaryError %}
                                        {% if summary.simultaneousNoteCount > 0 %}
                                            <button
                                                    type="button"
                                                    class="btn-mini warning"
                                                    data-url="{{ path('doc_asset_stagger_notes', { id: document.id, assetId: a.id }) }}"
                                                    data-csrf="{{ csrf_token('stagger-notes-' ~ a.id) }}"
                                                    onclick="staggerNotes(this.dataset.url, this.dataset.csrf)"
                                                    title="Verschuif gelijktijdige noten elk 1 tick naar achteren"
                                            >Stagger noten</button>
                                        {% endif %}

                                        {% if summary.trackCount > 1 %}
                                            <button
                                                    type="button"
                                                    class="btn-mini"
                                                    data-url="{{ path('doc_asset_split_tracks', { id: document.id, assetId: a.id }) }}"
                                                    data-csrf="{{ csrf_token('split-tracks-' ~ a.id) }}"
                                                    onclick="splitTracks(this.dataset.url, this.dataset.csrf)"
                                            >Split tracks</button>
                                        {% endif %}

                                        {% if summary.trackCount == 1 and summary.simultaneousNoteCount == 0 %}
                                            <button
                                                    type="button"
                                                    class="btn-mini"
                                                    onclick="createTrackFromMidiAsset({{ a.id }})"
                                                    title="Maak direct een nieuwe track op basis van dit MIDI-bestand"
                                            >Create track</button>
                                        {% endif %}
                                    {% endif %}

                                    {# Error message (if any) #}
                                    {% if summaryError %}
                                        <span class="subtle">midi-analyse mislukt</span>
                                        {% if is_granted('ROLE_ADMIN') %}
                                            <code class="subtle">{{ summaryError }}</code>
                                        {% endif %}
                                    {% endif %}

                                    {# 4. Icon group: Edit, Download, Delete (always together) #}
                                    <div class="chip-actions-icons">
                                        {# Edit button for rename #}
                                        <button
                                                type="button"
                                                class="btn-mini-icon"
                                                onclick="toggleAssetRename({{ a.id }})"
                                                title="Hernoemen"
                                        >
                                            <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M12 20h9"></path>
                                                <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L8 18l-4 1 1-4 11.5-11.5Z"></path>
                                            </svg>
                                        </button>

                                        {# Download button with SVG icon #}
                                        <a href="{{ midiUrl }}" class="btn-mini-icon" title="Download">
                                            <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                                <polyline points="7 10 12 15 17 10"></polyline>
                                                <line x1="12" y1="15" x2="12" y2="3"></line>
                                            </svg>
                                        </a>

                                        {# Delete button with SVG icon #}
                                        <button
                                                type="button"
                                                class="btn-mini-icon danger"
                                                data-url="{{ path('doc_asset_delete', { id: document.id, assetId: a.id }) }}"
                                                data-csrf="{{ csrf_token('delete-asset-' ~ a.id) }}"
                                                data-name="{{ a.originalName }}"
                                                onclick="deleteAsset(this.dataset.url, this.dataset.csrf, this.dataset.name)"
                                                title="Verwijder"
                                        >
                                            <svg class="icon" viewBox="0 0 24 24" fill="none" aria-hidden="true" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                                <polyline points="3 6 5 6 21 6"></polyline>
                                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                                                <line x1="10" y1="11" x2="10" y2="17"></line>
                                                <line x1="14" y1="11" x2="14" y2="17"></line>
                                            </svg>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            {# ── Preview button: opens shared loop editor modal ── #}

                        </div>
                    {% endmacro %}

                    {% import _self as midiui %}

                    <div>
                        <label class="label">MIDI bestanden in project</label>

                        {% set parents = assetsParents ?? [] %}

                        {% if parents|length %}
                            <div class="chips" style="margin-top:8px">

                                <style>
                                    .chip-child {
                                        margin-left: 18px;
                                        opacity: 0.96;
                                    }
                                    .chip-child .chip-name {
                                        font-size: 0.95em;
                                    }

                                    /* Info midi file onder naam, compact */
                                    .chip-main-stack{
                                        display: flex;
                                        flex-direction: column;
                                        align-items: flex-start; /* ← dit is de sleutel */
                                        gap: 2px;
                                        min-width: 0;
                                        line-height: 1.1;
                                    }
                                    .chip-meta-below{
                                        text-align: left;        /* extra expliciet */
                                        align-self: flex-start;  /* belt + suspenders */
                                    }

                                    /* optioneel maar handig: lange namen niet alles laten oprekken */
                                    .chip-name{
                                        white-space: nowrap;
                                        overflow: hidden;
                                        text-overflow: ellipsis;
                                        max-width: 100%;
                                    }

                                    /* Chip herstructurering: rij + uitklapbare preview */
                                    .chip {
                                        display: flex;
                                        flex-direction: column;
                                        align-items: stretch;
                                        gap: 0;
                                        white-space: normal; 
                                        max-width: 100%;
                                        min-width: 0; /* Essentieel voor flex-containment */
                                        box-sizing: border-box;
                                        overflow: hidden;
                                    }
                                    .chip * { box-sizing: border-box; }
                                    .chip-row {
                                        display: flex;
                                        justify-content: space-between;
                                        align-items: center;
                                        white-space: nowrap;
                                        width: 100%;
                                        min-width: 0;
                                    }
                                    .chip-preview {
                                        margin-top: 10px;
                                        width: 100%;
                                        max-width: 100%;
                                        min-width: 0;
                                        white-space: normal;
                                        overflow: hidden;
                                    }
                                    .chip-preview[hidden] { display: none; }

                                    /* midi-player: aanpassen aan donker thema */
                                    midi-player {
                                        display: block;
                                        width: 100%;
                                        max-width: 100%;
                                        min-width: 0;
                                        --player-button-size: 28px;
                                        --color-primary: #5865f2;
                                        --color-secondary: #3bcdf7;
                                    }
                                    /* Pianorol: donkere achtergrond + accent kleuren */
                                    .piano-roll-wrapper {
                                        overflow-x: auto;
                                        overflow-y: hidden;
                                        width: 100%;
                                        max-width: 100%;
                                        min-width: 0;
                                        margin-top: 6px;
                                        border-radius: 8px;
                                        background: #070f1f;
                                        /* Moderne scrollbar */
                                        scrollbar-width: thin;
                                        scrollbar-color: #5865f2 #070f1f;
                                    }
                                    .piano-roll-wrapper::-webkit-scrollbar {
                                        height: 6px;
                                    }
                                    .piano-roll-wrapper::-webkit-scrollbar-track {
                                        background: #070f1f;
                                    }
                                    .piano-roll-wrapper::-webkit-scrollbar-thumb {
                                        background-color: #5865f2;
                                        border-radius: 10px;
                                    }

                                    midi-visualizer {
                                        display: block;
                                        min-width: 100%;
                                        width: fit-content;
                                        --background-color: transparent;
                                        --black-key-color:  #1a2540;
                                        --white-key-color:  #0f1a30;
                                        --note-color:       #5865f2;
                                        --active-note-color: #3bcdf7;
                                    }
                                    /* Hoogte van de pianorol beperken */
                                    midi-visualizer svg {
                                        max-height: 220px;
                                        width: 100%; /* laat breedte op basis van MIDI data */
                                    }

                                    .badge-warning {
                                        display: inline-block;
                                        font-size: 0.78em;
                                        color: #92400e;
                                        background: #fef3c7;
                                        border: 1px solid #f59e0b;
                                        border-radius: 4px;
                                        padding: 1px 5px;
                                        margin-top: 2px;
                                    }

                                    .btn-mini.warning {
                                        background: #fef3c7;
                                        border-color: #f59e0b;
                                        color: #92400e;
                                    }
                                    .btn-mini.warning:hover {
                                        background: #fde68a;
                                    }
                                </style>

                                {% for a in parents %}
                                    {{ midiui.render_chip(a, document, midiSummariesByAssetId, false, null) }}

                                    {% set kids = (assetsChildrenById[a.id] ?? []) %}
                                    {% if kids|length %}
                                        {% for c in kids %}
                                            {# Je kunt childLabel ook null laten. Dit is een compact labeltje. #}
                                            {% set childLabel = 'track' %}
                                            {{ midiui.render_chip(c, document, midiSummariesByAssetId, true, childLabel) }}
                                        {% endfor %}
                                    {% endif %}

                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="subtle" style="margin-top:6px">
                                Nog geen bestanden naar de server verzonden. Upload één of meer .mid-bestanden.
                            </p>
                        {% endif %}
                    </div>
                </div>
            </div>
                </div>
            </details>

            {# --- Tracks (DocumentTrack) --- #}
            <details class="page-collapsible page-collapsible-tracks">
                <summary class="page-collapsible-summary">Tracks</summary>
                <div class="page-collapsible-body">
            <div class="section tracks-section">
                {# 1) Prototype track-kaart #}
                {% set track_proto %}
                    {% include 'Document/_track_card.html.twig' with {
                        trackForm:   form.tracks.vars.prototype,
                        index:       '__name__',
                        num:         '__num__',
                        isPrototype: true,
                        midiInfo:    {},
                        document:    document
                    } only %}
                {% endset %}

                {# 2) Container met bestaande tracks #}
                <div id="tracks"
                     class="tracks"
                     data-index="{{ form.tracks|length }}"
                     data-prototype="{{ track_proto|e('html_attr') }}">

                    {% for trackForm in form.tracks %}
                        {% include 'Document/_track_card.html.twig' with {
                            trackForm:   trackForm,
                            index:       loop.index0,
                            num:         loop.index,
                            isPrototype: false,
                            midiInfo:    midiInfo,
                            document:    document
                        } only %}
                    {% else %}
                        <p class="subtle">Nog geen tracks.</p>
                    {% endfor %}
                </div>
            </div>
                </div>
            </details>

            {# Markeer custom gerenderde velden #}
            {% do form.tracks.setRendered %}

            {# Render published alvast, maar bewaar in variabele. Hierdoor is hij "gerenderd" vóór form_rest. #}
            {% set publishedRow %}
                {{ form_row(form.published, {
                    attr: form.published.vars.attr|merge({ form: 'document-form' })
                }) }}
            {% endset %}

            {{ form_rest(form) }}
            {{ form_end(form, { render_rest: false }) }}

        </div>
    </div>

    {# --- Sticky/Fixed bottom bar OUTSIDE card/wrap --- #}
    <div class="bottom-bar">
        <div class="bottom-bar-inner">

            <div class="bottom-bar-flashes">
                {% for type, messages in app.flashes %}
                    {% for msg in messages %}
                        <div class="flash flash-{{ type }}">{{ msg }}</div>
                    {% endfor %}
                {% endfor %}
            </div>

            <div class="bottom-bar-actions">
                <div class="bottom-bar-published">
                    {{ publishedRow|raw }}
                    <a
                            href="{{ path('doc_api_json', { id: document.id }) }}"
                            title="Download laatst opgeslagen JSON voor deze set"
                            class="bottom-bar-download"
                            style="
                                padding-left: 12px;
                                text-decoration:none;
                                font-size: 13px;
                                color: var(--text);
                                opacity: 0.8;
                                "
                    >⬇️<span style="padding-left: 6px;">Download JSON</span></a>
                </div>

                <button class="btn" type="submit" form="document-form">Opslaan</button>
                <a class="btn secondary" href="{{ path('app_dashboard') }}">Terug</a>
            </div>

        </div>
    </div>
    </div>

    {# --- Piano Roll Loop Editor Modal --- #}
    <div id="piano-roll-modal" class="modal-overlay" hidden>
        <div class="modal-card piano-roll-modal-card">
            <div class="modal-header">
                <div>
                    <h3>Loop Bewerken (Piano Roll)</h3>
                    <div class="pr-header-controls">
                        <label for="pr-loop-length-input">Lengte (tellen):</label>
                        <div class="stepper-control">
                            <button type="button" class="stepper-btn js-pr-length-minus">−</button>
                            <input type="number" id="pr-loop-length-input" class="js-pr-length-input" value="48" min="1">
                            <button type="button" class="stepper-btn js-pr-length-plus">+</button>
                        </div>
                    </div>
                </div>
                <button type="button" class="close-btn js-pr-close">&times;</button>
            </div>
            <div class="modal-body piano-roll-modal-body">
                <canvas id="piano-roll-canvas"></canvas>
            </div>
            <div class="modal-footer">
                <span id="pr-selection-info" class="subtle">Selecteer een gebied op de tijdlijn...</span>
                <div class="modal-actions">
                    <button type="button" class="btn js-pr-play piano-roll-play-btn" title="Voorbeeld afspelen (vasthouden)">▶ Voorbeeld</button>
                    <button type="button" class="btn secondary js-pr-cancel">Annuleren</button>
                    <button type="button" class="btn js-pr-save">Opslaan</button>
                </div>
            </div>
        </div>
    </div>

    <style>
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(0,0,0,0.8);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 9999;
        }
        .modal-overlay[hidden] {
            display: none !important;
        }
        .piano-roll-modal-card {
            background: #1e293b;
            border: 1px solid #334155;
            border-radius: 8px;
            width: 90vw;
            max-width: 1000px;
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
        }
        .modal-header {
            padding: 16px;
            border-bottom: 1px solid #334155;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-header h3 { margin: 0; font-size: 1.1em; }
        .pr-header-controls {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-top: 12px;
            font-size: 0.9em;
        }
        .stepper-control {
            display: flex;
            align-items: center;
            gap: 4px;
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 4px;
            padding: 2px 4px;
        }
        .stepper-btn {
            background: none;
            border: none;
            color: #94a3b8;
            cursor: pointer;
            padding: 4px 8px;
            font-size: 1.1em;
            line-height: 1;
        }
        .stepper-btn:hover {
            color: #cbd5e1;
            background: rgba(148, 163, 184, 0.1);
        }
        .js-pr-length-input {
            width: 60px;
            background: transparent;
            border: none;
            color: #94a3b8;
            text-align: center;
            font-size: 0.9em;
            padding: 2px;
        }
        .js-pr-length-input:focus {
            outline: none;
            color: #cbd5e1;
        }
        .close-btn {
            background: none; border: none; color: #fff; font-size: 1.5em; cursor: pointer;
        }
        .piano-roll-modal-body {
            padding: 16px;
            overflow-x: auto;
            background: #0f172a;
        }
        #piano-roll-canvas {
            display: block;
            border: 1px solid #334155;
            background: #0f172a;
            cursor: crosshair;
        }
        .modal-footer {
            padding: 16px;
            border-top: 1px solid #334155;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .modal-actions {
            display: flex;
            gap: 10px;
        }

        /* Export Dialog */
        .export-dialog-overlay {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
        }

        .export-dialog {
            background: #1e1e2e;
            border: 1px solid #404060;
            border-radius: 8px;
            padding: 24px;
            width: 90%;
            max-width: 500px;
            color: #e0e0e0;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.8);
        }

        .dialog-header {
            margin-bottom: 20px;
        }

        .dialog-header h3 {
            margin: 0 0 8px 0;
            font-size: 18px;
            color: #fff;
        }

        .dialog-header .subtle {
            color: #888;
            font-size: 14px;
        }

        .dialog-body {
            margin-bottom: 20px;
        }

        .radio-group {
            margin-bottom: 16px;
            padding: 12px;
            background: rgba(255, 255, 255, 0.05);
            border-radius: 6px;
        }

        .radio-option {
            display: flex;
            align-items: center;
            gap: 10px;
            cursor: pointer;
            margin-bottom: 8px;
        }

        .radio-option input[type="radio"] {
            cursor: pointer;
            width: 18px;
            height: 18px;
        }

        .label-text {
            flex: 1;
        }

        .radio-option-detail {
            margin-left: 28px;
            margin-top: 8px;
            display: none;
        }

        .new-filename-input,
        .existing-asset-select {
            width: 100%;
            padding: 8px 12px;
            background: #2a2a3e;
            border: 1px solid #404060;
            border-radius: 4px;
            color: #e0e0e0;
            font-size: 14px;
        }

        .new-filename-input:focus,
        .existing-asset-select:focus {
            outline: none;
            border-color: #3bcdf7;
            box-shadow: 0 0 0 2px rgba(59, 205, 247, 0.2);
        }

        .existing-asset-select option {
            background: #1e1e2e;
            color: #e0e0e0;
        }

        .dialog-footer {
            display: flex;
            gap: 12px;
            justify-content: flex-end;
        }

        .export-cancel,
        .export-submit {
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
        }

        .export-cancel {
            background: #404060;
            color: #e0e0e0;
        }

        .export-cancel:hover {
            background: #505080;
        }

        .export-submit {
            background: #3bcdf7;
            color: #0f172a;
            font-weight: 600;
        }

        .export-submit:hover {
            background: #5adeff;
        }

        .export-submit:active {
            transform: scale(0.98);
        }
    </style>

